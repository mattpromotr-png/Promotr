# Shared/public application configuration (local + Vercel)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key

# Next.js server only (local + Vercel)
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
ADMIN_EMAIL=owner@example.com
LEAD_RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters
STRIPE_SECRET_KEY=sk_test_replace-with-stripe-test-secret-key
STRIPE_WEBHOOK_SECRET=whsec_replace-with-stripe-webhook-secret

# Transactional booking email (Resend free tier)
RESEND_API_KEY=re_replace-with-resend-api-key
BOOKING_EMAIL_FROM=Promotr Bookings <bookings@your-verified-domain.com>

# Two-way Gmail inbox (Google OAuth; never use the mailbox password)
GMAIL_CLIENT_ID=replace-with-google-oauth-client-id
GMAIL_CLIENT_SECRET=replace-with-google-oauth-client-secret
GMAIL_EXPECTED_ADDRESS=matt.promotr@gmail.com
# 32 random bytes encoded as base64. Used only to encrypt the refresh token at rest.
GMAIL_TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64-key
# Optional real-time Gmail push. Without this, call /api/cron/gmail-sync securely.
GMAIL_PUBSUB_TOPIC=
# Required only when using real-time Pub/Sub push delivery.
GMAIL_PUBSUB_AUDIENCE=
GMAIL_PUBSUB_SERVICE_ACCOUNT_EMAIL=

# OpenAI (n8n and main app server for staff reply translation)
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=gpt-4.1-mini

# Secures the Supabase Cron -> Vercel follow-up endpoint
CRON_SECRET=replace-with-long-random-secret

# Twilio SMS (server only)
TWILIO_ACCOUNT_SID=AC_replace-with-account-sid
TWILIO_API_KEY_SID=SK_replace-with-restricted-api-key-sid
TWILIO_API_KEY_SECRET=replace-with-api-key-secret
TWILIO_AUTH_TOKEN=replace-with-auth-token-for-webhook-validation
TWILIO_PHONE_NUMBER=+14165550123
# Optional: when set, messages use this service instead of the individual number.
TWILIO_MESSAGING_SERVICE_SID=

# Meta app and Instagram Messaging API (n8n, except verification/signature secrets also used by Vercel)
META_APP_ID=replace-with-meta-app-id
META_APP_SECRET=replace-with-instagram-app-secret-from-instagram-login-setup
# Optional explicit signing keys for the same Meta app. Leave unused keys empty.
META_INSTAGRAM_APP_SECRET=
META_BASIC_APP_SECRET=
META_ACCESS_TOKEN=replace-with-meta-access-token
META_VERIFY_TOKEN=replace-with-a-random-webhook-verify-token
META_INSTAGRAM_ACCOUNT_ID=replace-with-instagram-professional-account-id
META_PAGE_ID=replace-if-required-by-the-authorized-api-path
META_GRAPH_API_VERSION=replace-with-current-supported-version

# Secure Next.js -> n8n handoff (same value configured in both environments)
N8N_INSTAGRAM_WEBHOOK_URL=https://YOUR_N8N_HOST/webhook/promotr-instagram
N8N_SHARED_SECRET=replace-with-at-least-32-random-characters
