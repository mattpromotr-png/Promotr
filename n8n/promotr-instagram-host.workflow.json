{
  "name": "Promotr Instagram - Shared Vera Concierge",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "promotr-instagram",
        "authentication": "headerAuth",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook",
      "name": "Receive Verified Instagram Event",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-500, 80],
      "credentials": {
        "httpHeaderAuth": {
          "id": "SELECT_N8N_SHARED_SECRET_CREDENTIAL",
          "name": "Promotr n8n shared secret"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://YOUR_PROMOTR_DOMAIN/api/internal/instagram/events",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.body }}",
        "options": { "timeout": 12000 }
      },
      "id": "shared-vera",
      "name": "Hand Off to Shared Vera Engine",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-220, 80],
      "retryOnFail": true,
      "maxTries": 3,
      "credentials": {
        "httpHeaderAuth": {
          "id": "SELECT_N8N_SHARED_SECRET_CREDENTIAL",
          "name": "Promotr n8n shared secret"
        }
      }
    },
    {
      "parameters": {
        "content": "## Production workflow: one active Instagram workflow\nMeta sends signed DMs to Promotr's /api/webhooks/meta, which validates and deduplicates them before forwarding here. Replace YOUR_PROMOTR_DOMAIN with the deployed HTTPS domain. Use an n8n Header Auth credential named X-Promotr-Secret with the same N8N_SHARED_SECRET held by Vercel. The shared application engine now owns Vera prompts, memory, translation, rapid-message grouping, follow-ups, Meta outbound sending and manager notifications. Never put Meta, OpenAI or Supabase secrets in this workflow export. Keep the mock workflow inactive. Activate only after the new database migration and app deployment, then perform a real Instagram DM test."
      },
      "id": "notes",
      "name": "Setup Notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-500, -180]
    }
  ],
  "connections": {
    "Receive Verified Instagram Event": {
      "main": [[{ "node": "Hand Off to Shared Vera Engine", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" }
}
